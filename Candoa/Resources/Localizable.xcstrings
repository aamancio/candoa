    "Nothing sticks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts bleibt zurück"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada se conserva"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est conservé"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も残りません"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada fica salvo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什么都不会留下"
          }
        }
      }
    },
    "Nothing. Candoa doesn't record which requests were blocked or keep a per-site tally, so this report never contains your browsing history and there is no report data to clear." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts. Candoa zeichnet nicht auf, welche Anfragen blockiert wurden, und führt keine Zählung pro Website. Dieser Bericht enthält daher nie Ihren Browserverlauf, und es gibt keine Berichtsdaten zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada. Candoa no registra qué solicitudes se bloquearon ni lleva un recuento por sitio, así que este informe nunca contiene tu historial de navegación y no hay datos del informe que borrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien. Candoa n'enregistre pas quelles requêtes ont été bloquées et ne tient aucun décompte par site : ce rapport ne contient donc jamais votre historique de navigation, et il n'y a aucune donnée de rapport à effacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も保存しません。Candoaはどのリクエストがブロックされたかを記録せず、サイトごとの集計も行いません。そのため、このレポートに閲覧履歴が含まれることはなく、消去すべきレポートデータも存在しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada. O Candoa não registra quais solicitações foram bloqueadas nem mantém uma contagem por site, então este relatório nunca contém seu histórico de navegação e não há dados de relatório para apagar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什么都不保留。Candoa 不会记录哪些请求被拦截，也不会按网站计数，因此本报告绝不包含您的浏览历史，也没有任何报告数据需要清除。"
          }
        }
      }
    },
