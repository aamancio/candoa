    "iCloud restored your Spaces and tabs, so this Mac can pick up right where you left off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud restauró tus Espacios y pestañas, así que este Mac puede continuar justo donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud a restauré vos Espaces et vos onglets, ce Mac peut donc reprendre là où vous vous étiez arrêté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud hat Ihre Spaces und Tabs wiederhergestellt, sodass dieser Mac genau dort weitermachen kann, wo Sie aufgehört haben."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudがスペースとタブを復元したので、このMacで前回の続きからすぐに再開できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 已恢复你的空间和标签页，这台 Mac 可以从你上次离开的地方继续。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud restaurou seus Espaços e abas, e este Mac pode continuar exatamente de onde você parou."
          }
        }
      }
    },
