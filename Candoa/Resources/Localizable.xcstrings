    "How much the model thinks before answering. Low is fastest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel das Modell vor der Antwort nachdenkt. Niedrig ist am schnellsten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto piensa el modelo antes de responder. El nivel bajo es el más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps de réflexion du modèle avant de répondre. Faible est le réglage le plus rapide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答する前にモデルがどれだけ思考するかを設定します。「低」が最も高速です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o modelo pensa antes de responder. Baixo é o mais rápido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型在回答前思考的程度。“低”最快。"
          }
        }
      }
    },
    "I need you to handle something in this tab, then continue." : {
      "localizations" : {
        "de" : {
