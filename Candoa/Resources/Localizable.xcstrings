    "Add a %@ API key in Candoa Settings before using your own key." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una clave de API de %@ en los Ajustes de Candoa antes de usar tu propia clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une clé d’API %@ dans les Réglages de Candoa avant d’utiliser votre propre clé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
