    "Keep work, personal browsing, and projects separate so you can switch context without losing your place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie Arbeit, privates Surfen und Projekte getrennt, damit Sie den Kontext wechseln können, ohne den Faden zu verlieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
