      }
    },
    "Candoa couldn’t find your account on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa konnte Ihren Account auf diesem Mac nicht finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa no encontró tu cuenta en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
