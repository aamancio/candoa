          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa 无法打开结账页面。请重试。"
          }
        }
      }
    },
    "Candoa couldn’t read that bookmarks file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa konnte diese Lesezeichendatei nicht lesen."
          }
