    "Block trackers and ads with WebKit content rules. Pages already open apply the change when they reload." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockiert Tracker und Werbung mit WebKit-Inhaltsregeln. Bereits geöffnete Seiten übernehmen die Änderung beim Neuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea rastreadores y anuncios con reglas de contenido de WebKit. Las páginas ya abiertas aplican el cambio cuando se vuelven a cargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque les traqueurs et les publicités avec les règles de contenu WebKit. Les pages déjà ouvertes appliquent le changement lors de leur rechargement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKitのコンテンツルールでトラッカーと広告をブロックします。すでに開いているページには、再読み込み時に変更が適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueia rastreadores e anúncios com regras de conteúdo do WebKit. As páginas já abertas aplicam a alteração quando são recarregadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 WebKit 内容规则阻止跟踪器和广告。已打开的页面会在重新载入时应用此更改。"
          }
        }
      }
    },
