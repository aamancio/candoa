    "Requests to known trackers are stopped inside WebKit's network process, before they ever leave this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfragen an bekannte Tracker werden im Netzwerkprozess von WebKit gestoppt, bevor sie diesen Mac überhaupt verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes a rastreadores conocidos se detienen en el proceso de red de WebKit, antes de que lleguen a salir de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes vers les traqueurs connus sont arrêtées dans le processus réseau de WebKit, avant même de quitter ce Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既知のトラッカーへのリクエストは、このMacから出る前にWebKitのネットワークプロセス内で止められます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As solicitações a rastreadores conhecidos são interrompidas no processo de rede do WebKit, antes mesmo de saírem deste Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对已知跟踪器的请求会在 WebKit 的网络进程中被拦截，绝不会离开这台 Mac。"
          }
        }
      }
    },
