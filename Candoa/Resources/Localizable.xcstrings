    },
    "Candoa stores one key per provider in this Mac's Keychain. Keys are never sent to Candoa." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa sichert einen Schlüssel pro Anbieter im Schlüsselbund dieses Mac. Schlüssel werden nie an Candoa gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa guarda una clave por proveedor en el llavero de este Mac. Las claves nunca se envían a Candoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa conserve une clé par fournisseur dans le trousseau de ce Mac. Les clés ne sont jamais envoyées à Candoa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoaはプロバイダごとに1つのキーをこのMacのキーチェーンに保存します。キーがCandoaに送信されることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Candoa armazena uma chave por provedor no Chaveiro deste Mac. As chaves nunca são enviadas ao Candoa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa 会将每个提供商的一个密钥存储在这台 Mac 的钥匙串中。密钥绝不会发送给 Candoa。"
          }
        }
      }
    },
    "Candoa updated — see what's new" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa aktualisiert — Neuheiten ansehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa se ha actualizado — descubre las novedades"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa a été mis à jour — découvrez les nouveautés"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoaがアップデートされました — 新機能を見る"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa atualizado — veja as novidades"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa 已更新 — 查看新功能"
          }
        }
      }
    },
    "Candoa's protection list is compiled into WebKit content rules once. A blocked request simply never happens — no script watches the pages you visit, and no extra work runs while you browse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoas Schutzliste wird einmalig in WebKit-Inhaltsregeln kompiliert. Eine blockierte Anfrage findet schlicht nie statt – kein Skript beobachtet die von Ihnen besuchten Seiten, und beim Surfen fällt keine zusätzliche Arbeit an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista de protección de Candoa se compila una sola vez en reglas de contenido de WebKit. Una solicitud bloqueada simplemente nunca ocurre: ningún script observa las páginas que visitas y no se ejecuta trabajo adicional mientras navegas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste de protection de Candoa est compilée une seule fois en règles de contenu WebKit. Une requête bloquée n'a tout simplement jamais lieu : aucun script ne surveille les pages que vous visitez et aucun travail supplémentaire ne s'exécute pendant votre navigation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoaの保護リストは一度だけWebKitのコンテンツルールにコンパイルされます。ブロックされたリクエストはそもそも発生しません。訪問したページを監視するスクリプトはなく、ブラウズ中に余分な処理も実行されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista de proteção do Candoa é compilada uma única vez em regras de conteúdo do WebKit. Uma solicitação bloqueada simplesmente nunca acontece — nenhum script observa as páginas que você visita e nenhum trabalho extra é executado enquanto você navega."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa 的保护列表只会编译一次为 WebKit 内容规则。被拦截的请求根本不会发生——没有脚本监视您访问的页面，浏览时也不会产生额外的工作。"
          }
        }
      }
    },
