    "This extension can read and alter webpages you visit and see your browsing history on all websites." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Erweiterung kann von dir besuchte Webseiten lesen und verändern sowie deinen Browserverlauf auf allen Websites sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta extensión puede leer y modificar las páginas web que visitas y ver tu historial de navegación en todos los sitios web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette extension peut lire et modifier les pages web que vous consultez et voir votre historique de navigation sur tous les sites web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この拡張機能は、訪問したWebページの読み取りと変更、およびすべてのWebサイトでの閲覧履歴の表示ができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta extensão pode ler e alterar as páginas que você visita e ver seu histórico de navegação em todos os sites."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
