    "Removing website data also clears cookies, caches, and other data those websites stored for the same period, which may sign you out of them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar los datos de sitios web también se borran las cookies, las cachés y otros datos que esos sitios guardaron durante el mismo período, lo que puede cerrar tu sesión en ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression des données de sites web efface aussi les cookies, les caches et les autres données que ces sites ont stockées pour la même période, ce qui peut vous déconnecter de ces sites."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entfernen von Websitedaten werden auch Cookies, Caches und andere Daten gelöscht, die diese Websites im selben Zeitraum gespeichert haben. Dadurch werden Sie dort möglicherweise abgemeldet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webサイトデータを削除すると、同じ期間にそれらのWebサイトが保存したCookie、キャッシュ、その他のデータも消去され、サインアウトされる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除网站数据的同时也会清除这些网站在同一时段内存储的 Cookie、缓存和其他数据，这可能会使你退出这些网站的登录。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover dados de sites também limpa cookies, caches e outros dados que esses sites armazenaram no mesmo período, o que pode encerrar sua sessão neles."
          }
        }
      }
    },
