    "macOS requires permission before Candoa can read %@’s bookmarks." : {
      "comment" : "Placeholder is a browser name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS erfordert eine Berechtigung, bevor Candoa die Lesezeichen von %@ lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS requiere permiso antes de que Candoa pueda leer los marcadores de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS exige une autorisation avant que Candoa puisse lire les signets de %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoaが%@のブックマークを読み込むには、macOSの許可が必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS exige permissão antes que o Candoa possa ler os marcadores do %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 要求先获得权限，Candoa 才能读取 %@ 的书签。"
          }
        }
      }
    },
    "Magic" : {
      "comment" : "Space icon picker: label for the 'wand.and.stars' symbol (a magic wand).",
      "localizations" : {
        "de" : {
