    "Candoa couldn’t verify your account before checkout." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa konnte Ihren Account vor dem Bezahlvorgang nicht überprüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa no pudo verificar tu cuenta antes de la compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa n’a pas pu vérifier votre compte avant le paiement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックアウトの前にアカウントを確認できませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Candoa não conseguiu verificar sua conta antes do checkout."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa 无法在结账前验证你的账户。"
          }
        }
      }
    },
    "Candoa has its own themes, so Chrome and Firefox themes don't install here. Pick a look in Settings ▸ Spaces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa hat eigene Themes, deshalb lassen sich Chrome- und Firefox-Themes hier nicht installieren. Wähle einen Look unter Einstellungen ▸ Spaces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa tiene sus propios temas, así que los de Chrome y Firefox no se instalan aquí. Elige un aspecto en Ajustes ▸ Espacios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa a ses propres thèmes : ceux de Chrome et Firefox ne s’installent pas ici. Choisissez une allure dans Réglages ▸ Espaces."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa には独自のテーマがあるため、Chrome や Firefox のテーマはインストールできません。設定 ▸ スペースで外観を選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Candoa tem os próprios temas, então temas do Chrome e do Firefox não são instalados aqui. Escolha um visual em Ajustes ▸ Espaços."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa 有自己的主题，因此无法在此安装 Chrome 或 Firefox 主题。请在“设置 ▸ 空间”中选择外观。"
          }
        }
      }
    },
    "Candoa is still confirming your subscription. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa bestätigt Ihr Abonnement noch. Versuchen Sie es gleich erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa todavía está confirmando tu suscripción. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa confirme encore votre abonnement. Réessayez dans un instant."
          }
