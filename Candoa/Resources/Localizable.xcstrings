        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa no pudo completar Iniciar sesión con Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa n’a pas pu terminer « Se connecter avec Apple »."
          }
