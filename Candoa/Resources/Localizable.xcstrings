    "Candoa %@ is installing and will relaunch shortly" : {
      "comment" : "Update banner status; placeholder is a version number.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa %@ wird installiert und startet in Kürze neu"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa %@ se está instalando y se reiniciará en breve"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa %@ s’installe et redémarrera dans un instant"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa %@をインストール中です。まもなく再起動します"
