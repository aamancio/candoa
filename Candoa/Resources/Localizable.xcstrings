          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command-Eを押すとEliが開き、ページを離れずに要約、説明、比較、次のステップの確認ができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
