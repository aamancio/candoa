      }
    },
    "Candoa couldn’t access %@’s default profile. You can choose another profile manually." : {
      "comment" : "Placeholder is a browser name (Chrome, Safari).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa konnte nicht auf das Standardprofil von %@ zugreifen. Sie können manuell ein anderes Profil auswählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa no pudo acceder al perfil predeterminado de %@. Puedes elegir otro perfil manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa n’a pas pu accéder au profil par défaut de %@. Vous pouvez choisir un autre profil manuellement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoaは%@のデフォルトプロファイルにアクセスできませんでした。別のプロファイルを手動で選択できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Candoa não conseguiu acessar o perfil padrão do %@. Você pode escolher outro perfil manualmente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candoa 无法访问 %@ 的默认个人资料。你可以手动选择其他个人资料。"
          }
        }
      }
    },
    "Candoa couldn’t find %@ bookmark data in that folder." : {
      "comment" : "Placeholder is a browser name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
