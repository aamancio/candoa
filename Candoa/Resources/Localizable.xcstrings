    "Press Command-E to open Eli and summarize, explain, compare, or identify next steps without leaving the page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie Command-E, um Eli zu öffnen und Seiten zusammenzufassen, zu erklären, zu vergleichen oder nächste Schritte zu finden, ohne die Seite zu verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
